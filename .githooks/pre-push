#!/usr/bin/env bash
# Warn — never block — when pushing a branch whose review verdict is stale.
# Deliberately non-blocking: a hook that gates on a multi-minute review is a hook
# you will disable within a week. Set REVIEW_STRICT=1 to make it blocking.
set -uo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)" || exit 0
cd "$REPO_ROOT" || exit 0
[ -f scripts/review.sh ] || exit 0

# Judge the refs git is actually pushing, read from stdin as
# "<local_ref> <local_sha> <remote_ref> <remote_sha>". Using the checked-out
# branch instead would clear `git push origin other-branch` on the strength of
# the current branch's verdict, and REVIEW_STRICT would not block it. The
# verdict is still matched against local_sha — the commit being pushed.
ZERO="0000000000000000000000000000000000000000"
stale_refs=""

while read -r _local_ref local_sha remote_ref _remote_sha; do
  [ -n "${remote_ref:-}" ] || continue
  [ "$local_sha" = "$ZERO" ] && continue          # branch deletion
  # Branches only, judged by the DESTINATION ref: `git push origin
  # HEAD~1:refs/heads/feature` passes the commit expression as <local ref>, so a
  # refs/heads/* test against it matches nothing and the push goes unchecked.
  # A tag push has a refs/tags/* destination and is still skipped: its local_sha
  # is the tag object, never a reviewed commit.
  case "$remote_ref" in refs/heads/*) ;; *) continue ;; esac

  branch="${remote_ref#refs/heads/}"
  case "$branch" in main|master|develop) continue ;; esac

  if [ ! -f .review/verdict.md ]; then
    stale_refs="$stale_refs\n  $branch — no review verdict found"
  elif ! grep -q "${local_sha:0:10}" .review/verdict.md 2>/dev/null; then
    # The verdict must name the commit being pushed. File mtime is not evidence:
    # it says when the file was written, not which commit it judged.
    stale_refs="$stale_refs\n  $branch — verdict does not cover ${local_sha:0:10}"
  fi
done

[ -n "$stale_refs" ] || exit 0

printf '\n\033[33m[review]\033[0m stale or missing review verdict:%b\n' "$stale_refs"
printf '        Run \033[1m/review\033[0m in Claude Code before opening the PR.\n\n'
if [ "${REVIEW_STRICT:-0}" = "1" ]; then
  printf '        REVIEW_STRICT=1 — blocking. Push with: REVIEW_STRICT=0 git push\n\n'
  exit 1
fi
exit 0
